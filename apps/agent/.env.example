# Gemini API key — https://aistudio.google.com/apikey
# The hackathon requires Gemini 3.5 or newer.
GOOGLE_API_KEY=

# FALSE = use the Gemini API directly. TRUE = route through Vertex AI,
# which also needs GOOGLE_CLOUD_PROJECT and GOOGLE_CLOUD_LOCATION.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Overrides the default model (gemini-3.5-flash).
# ZANOBA_MODEL=gemini-3.5-flash

# Where the web app lives, and the secret it checks before letting the tutor
# write on a student's paper. Both must be set for marks to reach the browser;
# without them the tutor still teaches, but nothing appears on the worksheet.
ZANOBA_WEB_URL=https://zanoba.com
AGENT_TOKEN=

# The live model for a spoken lesson, and its voice. Live models are previews
# and get renamed, hence the override. A native-audio model picks the spoken
# language itself; a half-cascade one is told it — see live/audio.py.
# ZANOBA_LIVE_MODEL=gemini-3.1-flash-live-preview
# ZANOBA_LIVE_VOICE=Aoede

# Stock photography for the lesson decks. The picture pipeline searches for a
# real photograph before it asks an image model to draw one — a real kitchen and
# a real ticket machine are most of why the reference decks read as courseware.
#
# Free key, no card, one minute: https://www.pexels.com/api/
# Without it the search falls back to Openverse and Wikimedia Commons, which are
# keyless and free but return museum artefacts and holiday snapshots about as
# often as they return what was asked for.
PEXELS_API_KEY=
