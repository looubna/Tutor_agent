# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth — generate with: npx auth secret
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# HeyGen Streaming Avatar API (paid, pay-as-you-go) — https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=""
# Stock avatar id to use as the Math tutor's face. Browse avatars at https://app.heygen.com/avatars
HEYGEN_AVATAR_ID=""

# Base URL of the Python/ADK agent service (apps/agent)
AGENT_SERVICE_URL="http://localhost:8000"

# This app's own public URL — used to build Google Calendar event links and
# OAuth redirect URIs. Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Calendar sync (one-way: pushes booked lessons as events) — optional,
# the feature is silently disabled if unset. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials (Web application type),
# enable the Google Calendar API, and add
# http://localhost:3000/api/google-calendar/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google-calendar/callback"

# Resend — sends the "your lesson starts in 1 hour" reminder email. Optional,
# silently disabled if unset. Get an API key at https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Learnora <onboarding@resend.dev>"
