# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth — generate with: npx auth secret
# Signs the session cookie. The app refuses to boot without it.
#   openssl rand -base64 32
SESSION_SECRET=""

# This app's own public URL — used to build Google Calendar event links and
# OAuth redirect URIs. Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Calendar sync (one-way: pushes booked lessons as events) — optional,
# the feature is silently disabled if unset. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials (Web application type),
# enable the Google Calendar API, and add
# http://localhost:3000/api/google-calendar/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google-calendar/callback"

# Resend — sends the "your lesson starts in 1 hour" reminder email. Optional,
# silently disabled if unset. Get an API key at https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Learnora <onboarding@resend.dev>"

# The tutoring agent service (apps/agent). Without it a class still opens — the
# paper, the board and the camera all work — but nobody is teaching it.
AGENT_URL="http://localhost:8080"

# The shared secret the tutor agent presents when it reads a student's paper
# (GET /api/lesson/<id>/sheet) and writes on it (POST /api/lesson/<id>/marks).
# The same value goes in apps/agent/.env as AGENT_TOKEN. Unset means nobody may
# read or write: both endpoints fail closed rather than open.
AGENT_TOKEN=""

# Simli — the tutor's face. It renders a person lip-syncing in real time to
# audio we send, which is the one thing a spoken lesson needs and Gemini does
# not do. The lesson's own voice is streamed straight into her, so she never
# speaks words the tutor did not say and never answers late.
#
# The face id is a UUID. Simli's presets need no setup:
#   d2a5c7c6-fed9-4f55-bcb3-062f7cd20103  Kate
#   cace3ef7-a4c4-425d-a8cf-a5358eb0c427  Tina
#   b9e5fba3-071a-4e35-896e-211c4d6eaa7b  Laila
#   5fc23ea5-8175-4a82-aaaf-cdd8c88543dc  Madison
# A face of your own is made from a single photograph, either at app.simli.com
# or through the API: POST /faces/legacy?face_name=... with the image as
# multipart `image`, then poll /faces/legacy/generation_status. It takes about
# three minutes. Note the *legacy* generator — /faces/trinity is the newer one
# and the free plan allows none of those, answering 403 "max number of GS
# Faces" even with no faces on the account.
SIMLI_API_KEY=
SIMLI_FACE_ID=d2a5c7c6-fed9-4f55-bcb3-062f7cd20103
# Which Simli renderer drives the face: `artalk` is the more animated,
# `fasttalk` the lower-latency one. Optional; defaults to artalk.
SIMLI_MODEL=artalk
